[Unit]
Description=Deploy latest main Stripe, Fief and SMTP app builds
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash %h/.local/lib/opensensor-hosting/saleor-app-release-launch.sh
TimeoutStartSec=40min
UMask=0077
Nice=5
